{
	"name": "@mini-ecommerce/product-service",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"prisma:generate": "prisma generate --config prisma7.config.ts",
		"db:migrate": "prisma migrate dev --config prisma7.config.ts",
		"db:deploy": "prisma migrate deploy --config prisma7.config.ts",
		"db:seed": "prisma db seed --config prisma7.config.ts",
		"db:status": "prisma migrate status --config prisma7.config.ts",
		"db:reset": "prisma migrate reset --config prisma7.config.ts",
		"db:pull": "prisma db pull --config prisma7.config.ts",
		"db:prepare": "npm run prisma:generate && npm run db:deploy && npm run db:seed",
		"predev": "npm run db:prepare",
		"dev": "tsx watch src/index.ts",
		"build": "npm run prisma:generate && tsc -p tsconfig.build.json",
		"prestart": "npm run db:prepare",
		"start": "node dist/index.js",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"test": "vitest run",
		"test:unit": "vitest run test/unit",
		"test:integration": "vitest run --config vitest.config.integration.ts",
		"test:integration:watch": "vitest --config vitest.config.integration.ts",
		"test:e2e": "vitest run test/e2e",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage"
	},
	"dependencies": {
		"@prisma/adapter-pg": "^7.10.0",
		"@prisma/client": "^7.10.0",
		"dotenv": "^17.4.2",
		"express": "^5.2.1",
		"pg": "^8.23.0",
		"redis": "^6.2.1"
	},
	"devDependencies": {
		"@testcontainers/postgresql": "^12.1.0",
		"@types/express": "^5.0.6",
		"@types/node": "^24.13.5",
		"@types/pg": "^8.23.1",
		"@types/supertest": "^7.2.1",
		"@vitest/coverage-v8": "^5.0.1",
		"prisma": "^7.10.0",
		"supertest": "^7.2.2",
		"tsx": "^4.23.13",
		"typescript": "^6.0.3",
		"vitest": "^5.0.1",
		"vitest-mock-extended": "^5.1.1"
	}
}
